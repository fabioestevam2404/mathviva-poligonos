{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mathviva/content.schema.json",
  "title": "Conteúdo didático do MathViva 9 (content.js)",
  "description": "Contrato do objeto exportado por content.js: trilhas, resumos e a marcação da escola. Spec: specs/content.spec.md (CONT-10).",
  "type": "object",
  "required": ["topics", "topicGuides", "school"],
  "additionalProperties": false,
  "properties": {
    "topics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/topic" } },
    "topicGuides": {
      "type": "object",
      "patternProperties": { "^[a-z0-9_-]{1,64}$": { "$ref": "#/$defs/guide" } },
      "additionalProperties": false
    },
    "school": {
      "type": "object",
      "required": ["currentTopic"],
      "additionalProperties": false,
      "properties": { "currentTopic": { "type": ["string", "null"], "pattern": "^[a-z0-9_-]{1,64}$" } }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "topic": {
      "type": "object",
      "required": ["id", "module", "code", "ref", "name", "desc", "icon", "color", "tag", "minutes", "lesson", "example", "steps", "questions"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" },
        "module": { "type": "integer", "minimum": 1, "maximum": 99 },
        "code": { "type": "string", "pattern": "^\\d{1,2}\\.\\d{1,2}$" },
        "ref": { "type": "string", "pattern": "^Módulo \\d{1,2} · p\\. \\d" },
        "name": { "$ref": "#/$defs/text" },
        "desc": { "$ref": "#/$defs/text" },
        "icon": { "type": "string", "minLength": 1, "maxLength": 4 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "tag": { "type": "string", "pattern": "^[A-ZÀ-Ý0-9 ]+$" },
        "minutes": { "type": "integer", "minimum": 1, "maximum": 60 },
        "lesson": { "$ref": "#/$defs/text" },
        "example": { "$ref": "#/$defs/text" },
        "steps": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/text" } },
        "questions": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/question" } }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "q", "opts", "a", "hint", "why"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" },
        "q": { "$ref": "#/$defs/text" },
        "opts": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "a": { "type": "integer", "minimum": 0, "maximum": 3 },
        "hint": { "$ref": "#/$defs/text" },
        "why": { "$ref": "#/$defs/text" }
      }
    },
    "guide": {
      "type": "object",
      "required": ["title", "analogy", "sections", "formulas", "check"],
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "analogy": { "$ref": "#/$defs/text" },
        "sections": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/text" } }
        },
        "formulas": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/text" } },
        "check": { "$ref": "#/$defs/text" }
      }
    }
  }
}
